{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local immutable animation review",
  "type": "object",
  "required": ["task", "revision", "tracks"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"},
    "task": {"type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"},
    "revision": {"type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"},
    "title": {"type": "string"},
    "provenance": {"type": "string"},
    "approval": {"type": "string"},
    "owner_session": {"type": "string"},
    "tracks": {"type": "array", "minItems": 1, "maxItems": 128, "items": {
      "type": "object", "required": ["character", "action", "direction", "frames"],
      "properties": {
        "character": {"type": "string"}, "action": {"type": "string"}, "direction": {"type": "string"},
        "mirrored": {"type": "boolean"}, "mirror_safe": {"type": "boolean"},
        "frames": {"type": "array", "minItems": 1, "maxItems": 240, "items": {
          "type": "object", "required": ["sha256"], "properties": {
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "duration_ms": {"type": "integer", "minimum": 10, "maximum": 10000},
            "crop": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 4, "maxItems": 4}
          }
        }}
      }
    }}
  }
}
